     };
 }
 
++ (void)tani_getJSON:(NSString *)url completion:(void (^)(id json, NSError *error))completion {
+    NSURLSessionDataTask *task = [NSURLSession.sharedSession dataTaskWithURL:[NSURL URLWithString:url]
+    completionHandler:^(NSData *data, NSURLResponse *response, NSError *error) {
+        id json = nil;
+        if (!error && data) {
+            json = [NSJSONSerialization JSONObjectWithData:data options:NSJSONReadingMutableContainers error:&error];
+        }
+        completion(json, error);
+    }];
+    [task resume];
+}
+
++ (NSString *)tani_firstStable:(NSArray *)list {
+    if (![list isKindOfClass:NSArray.class]) return nil;
+    for (NSDictionary *v in list) {
+        if ([v[@"stable"] boolValue] && v[@"version"]) return v[@"version"];
+    }
+    return nil;
+}
+
++ (void)installLatestFabricProfileSelect:(BOOL)select completion:(void (^)(NSString *, NSError *))completion {
+    NSDictionary *endpoint = self.endpoints[@"Fabric"];
+    void (^fail)(NSError *) = ^(NSError *error) {
+        if (!error) {
+            error = [NSError errorWithDomain:@"TaniLauncher" code:1
+                userInfo:@{NSLocalizedDescriptionKey: @"Could not get Fabric version list"}];
+        }
+        NSLog(@"[Tani] Fabric auto-install failed: %@", error);
+        if (completion) dispatch_async(dispatch_get_main_queue(), ^{ completion(nil, error); });
+    };
+
+    [self tani_getJSON:endpoint[@"game"] completion:^(id games, NSError *error) {
+        NSString *gameVersion = [self tani_firstStable:games];
+        if (!gameVersion) { fail(error); return; }
+        [self tani_getJSON:endpoint[@"loader"] completion:^(id loaders, NSError *error) {
+            NSString *loaderVersion = [self tani_firstStable:loaders];
+            if (!loaderVersion) { fail(error); return; }
+            NSString *url = [NSString stringWithFormat:endpoint[@"json"], gameVersion, loaderVersion];
+            [self tani_getJSON:url completion:^(id profileJSON, NSError *error) {
+                if (![profileJSON isKindOfClass:NSDictionary.class] || !profileJSON[@"id"]) { fail(error); return; }
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    NSString *versionId = profileJSON[@"id"];
+                    NSString *jsonPath = [NSString stringWithFormat:@"%1$s/versions/%2$@/%2$@.json", getenv("GAME_DIR"), versionId];
+                    [NSFileManager.defaultManager createDirectoryAtPath:jsonPath.stringByDeletingLastPathComponent
+                        withIntermediateDirectories:YES attributes:nil error:nil];
+                    NSError *saveError = saveJSONToFile(profileJSON, jsonPath);
+                    if (saveError) { fail(saveError); return; }
+
+                    NSString *name = [NSString stringWithFormat:@"Fabric %@", gameVersion];
+                    PLProfiles *profiles = PLProfiles.current;
+                    if (!profiles.profiles[name]) {
+                        profiles.profiles[name] = @{
+                            @"name": name,
+                            @"icon": endpoint[@"icon"],
+                            @"lastVersionId": versionId
+                        }.mutableCopy;
+                    }
+                    if (select) {
+                        profiles.selectedProfileName = name; // also saves
+                    } else {
+                        [profiles save];
+                    }
+                    NSLog(@"[Tani] Built-in Fabric profile ready: %@ (%@)", name, versionId);
+                    if (completion) completion(name, nil);
+                });
+            }];
+        }];
+    }];
+}
+
 @end
